[Unit]
Description=netplane-client
Wants=network-online.target
After=network-online.target

[Service]
WorkingDirectory=/opt/netplane
ExecStart=/opt/netplane/netplane 116.203.59.48 --port=5000 --tun=tun0
Restart=on-failure
RestartSec=5
StandardOutput=append:/var/log/netplane-client.out.log
StandardError=append:/var/log/netplane-client.err.log

[Install]
WantedBy=multi-user.target
