use std::io::{Read, Write};
use tun::Configuration;

/// Calculate the IPv4 header checksum
fn calculate_ipv4_checksum(header: &[u8]) -> u16 {
    let mut sum = 0u32;

    // Sum all 16-bit words in the header
    for i in (0..header.len()).step_by(2) {
        if i + 1 < header.len() {
            let word = ((header[i] as u32) << 8) | (header[i + 1] as u32);
            sum += word;
        } else {
            let word = (header[i] as u32) << 8; // Odd byte, pad with zero
            sum += word;
        }
    }

    // Fold 32-bit sum to 16 bits
    while (sum >> 16) > 0 {
        sum = (sum & 0xFFFF) + (sum >> 16);
    }

    // Return the one's complement
    !(sum as u16)
}

fn calculate_tcp_checksum(packet: &[u8], source_ip: [u8; 4], dest_ip: [u8; 4]) -> u16 {
    let tcp_header_length = (packet[12] >> 4) * 4; // TCP data offset
    let tcp_total_length = packet.len() as u32;

    let mut sum = 0u32;

    // Pseudo-header
    for &byte in &source_ip {
        sum += byte as u32;
    }
    for &byte in &dest_ip {
        sum += byte as u32;
    }
    sum += 6; // Protocol number for TCP
    sum += tcp_total_length; // TCP length

    // TCP header and payload
    for i in (0..packet.len()).step_by(2) {
        if i + 1 < packet.len() {
            sum += ((packet[i] as u32) << 8) | (packet[i + 1] as u32);
        } else {
            sum += (packet[i] as u32) << 8; // Odd byte, pad with zero
        }
    }

    // Fold 32-bit sum to 16 bits
    while (sum >> 16) > 0 {
        sum = (sum & 0xFFFF) + (sum >> 16);
    }

    // Return the one's complement
    !(sum as u16)
}

fn main() -> std::io::Result<()> {
    // Create and configure the TUN device
    let mut config = Configuration::default();
    config.address("10.0.0.1")
        .netmask("255.255.255.0")
        .mtu(1500)
        .up();

    let mut tun = tun::create(&config)?;
    let mut buffer = [0u8; 1500];

    loop {
        // Read packet from the TUN device
        let bytes_read = tun.read(&mut buffer)?;
        println!("Packet received: {} bytes", bytes_read);

        if bytes_read < 20 {
            println!("Packet too short to process, skipping.");
            continue;
        }

        let packet = &mut buffer[..bytes_read];

        // Extract header length from the IHL field (first byte)
        let header_length = ((packet[0] & 0x0F) * 4) as usize;

        if bytes_read < header_length {
            println!("Packet too short for full IPv4 header, skipping.");
            continue;
        }

        // Log original source and destination IPs
        println!(
            "Original source: {}.{}.{}.{}",
            packet[12], packet[13], packet[14], packet[15]
        );
        println!(
            "Original destination: {}.{}.{}.{}",
            packet[16], packet[17], packet[18], packet[19]
        );

        // Change source IP (bytes 12–15) to 10.0.0.2
        packet[12] = 10;
        packet[13] = 0;
        packet[14] = 0;
        packet[15] = 2;

        // Change destination IP (bytes 16–19) to 192.168.1.100
        packet[16] = 192;
        packet[17] = 168;
        packet[18] = 1;
        packet[19] = 100;

        // Recalculate the IPv4 checksum
        packet[10] = 0; // Clear existing checksum
        packet[11] = 0;
        let checksum = calculate_ipv4_checksum(&packet[..header_length]);
        packet[10] = (checksum >> 8) as u8;
        packet[11] = (checksum & 0xFF) as u8;

        if packet[9] == 6 {
            let source_ip = [packet[12], packet[13], packet[14], packet[15]];
            let dest_ip = [packet[16], packet[17], packet[18], packet[19]];
            println!("HEADER LENGTH {}", header_length);
            let tcp_start = header_length;
            let tcp_segment = &mut packet[tcp_start..];

            // Recalculate TCP checksum
            tcp_segment[16] = 0; // Clear TCP checksum
            tcp_segment[17] = 0;
            let tcp_checksum = calculate_tcp_checksum(tcp_segment, source_ip, dest_ip);
            tcp_segment[16] = (tcp_checksum >> 8) as u8;
            tcp_segment[17] = (tcp_checksum & 0xFF) as u8;

            println!("TCP checksum recalculated: 0x{:04X}", tcp_checksum);
        }
        // Log new source and destination IPs
        println!(
            "Modified source: {}.{}.{}.{}",
            packet[12], packet[13], packet[14], packet[15]
        );
        println!(
            "Modified destination: {}.{}.{}.{}",
            packet[16], packet[17], packet[18], packet[19]
        );
        println!("Checksum recalculated: 0x{:04X}", checksum);

        // Write the modified packet back to the TUN device
        tun.write_all(&packet)?;
        println!("Packet forwarded.");
    }
}
