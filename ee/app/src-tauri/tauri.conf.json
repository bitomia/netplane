{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Netplane",
  "version": "0.1.0",
  "identifier": "com.bitomia.netplane",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Netplane",
        "width": 800,
        "minWidth": 475,
        "height": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "./wintun.dll",
      "icons/*",
      "icons/connected/*",
      "icons/disconnected/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
