name: Release app

on:
  push:
    branches: [ "main" ]
  workflow_dispatch:

concurrency:
  group: ${{ github.workflow }}
  cancel-in-progress: false

permissions:
  contents: read

env:
  CARGO_TERM_COLOR: always

jobs:
  android:
    runs-on: ubuntu-latest
    permissions:
      contents: write

    steps:
      - uses: actions/checkout@v4

      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Set up Android SDK
        uses: android-actions/setup-android@v3

      - name: Install Android NDK
        run: sdkmanager --install "ndk;27.0.12077973"

      - name: Set NDK_HOME
        run: echo "NDK_HOME=$ANDROID_HOME/ndk/27.0.12077973" >> $GITHUB_ENV

      - name: Set up Rust
        uses: dtolnay/rust-toolchain@stable
        with:
          targets: aarch64-linux-android,armv7-linux-androideabi,i686-linux-android,x86_64-linux-android

      - name: Rust cache
        uses: Swatinem/rust-cache@v2
        with:
          workspaces: ee/app/src-tauri -> target

      - name: Set up Bun
        uses: oven-sh/setup-bun@v2

      - name: Install dependencies
        working-directory: ee/app
        run: bun install

      - name: Build Android APK
        working-directory: ee/app
        run: bun run tauri android build --apk

      - name: Collect APKs
        shell: bash
        run: |
          mkdir -p dist
          find ee/app/src-tauri/gen/android -type f -name "*.apk" -exec cp {} dist/ \;
          ls -la dist/

      - name: Generate checksums
        shell: bash
        run: |
          cd dist
          for f in *.apk; do
            sha256sum "$f" > "$f.sha256"
          done

      - name: Upload GitHub Release
        uses: softprops/action-gh-release@v2
        with:
          tag_name: latest
          files: |
            dist/*.apk
            dist/*.apk.sha256
        env:
          GITHUB_TOKEN: ${{ secrets.GH_NETPLANE_RELEASE_TOKEN }}

  desktop:
    runs-on: ${{ matrix.os }}
    permissions:
      contents: write
    strategy:
      fail-fast: false
      matrix:
        include:
          - os: macos-latest
            target: aarch64-apple-darwin
          - os: macos-latest
            target: x86_64-apple-darwin
          - os: windows-latest
            target: x86_64-pc-windows-msvc

    steps:
      - uses: actions/checkout@v4

      - name: Set up Rust
        uses: dtolnay/rust-toolchain@stable
        with:
          targets: ${{ matrix.target }}

      - name: Rust cache
        uses: Swatinem/rust-cache@v2
        with:
          workspaces: ee/app/src-tauri -> target
          key: ${{ matrix.target }}

      - name: Set up Bun
        uses: oven-sh/setup-bun@v2

      - name: Install dependencies
        working-directory: ee/app
        run: bun install

      - name: Build Tauri app
        working-directory: ee/app
        run: bun run tauri build --target ${{ matrix.target }}

      - name: Collect artifacts
        shell: bash
        run: |
          mkdir -p dist
          shopt -s nullglob
          base="ee/app/src-tauri/target/${{ matrix.target }}/release/bundle"
          for f in "$base"/dmg/*.dmg \
                   "$base"/macos/*.app.tar.gz \
                   "$base"/msi/*.msi \
                   "$base"/nsis/*.exe; do
            cp "$f" dist/
          done
          ls -la dist/

      - name: Generate checksums
        shell: bash
        run: |
          cd dist
          for f in *; do
            [ -f "$f" ] || continue
            if command -v sha256sum >/dev/null 2>&1; then
              sha256sum "$f" > "$f.sha256"
            else
              shasum -a 256 "$f" > "$f.sha256"
            fi
          done

      - name: Upload GitHub Release
        uses: softprops/action-gh-release@v2
        with:
          tag_name: latest
          files: dist/*
        env:
          GITHUB_TOKEN: ${{ secrets.GH_NETPLANE_RELEASE_TOKEN }}
